# facedoor cloud-init network-config (netplan v2). Generated by deploy/sdcard/sdcard_tool.py (stage).
# Wired Ethernet always uses DHCP. Wi-Fi (if configured) stores a derived 64-hex WPA2 PSK, not the passphrase.
# Both interfaces are optional so boot does not wait for a missing network.
network:
  version: 2
  ethernets:
    eth0:
      dhcp4: true
      optional: true
{{WIFI_BLOCK}}
