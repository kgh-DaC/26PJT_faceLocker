#cloud-config
# facedoor cloud-init user-data. Generated {{GENERATED_AT}} by deploy/sdcard/sdcard_tool.py (stage).
# Copied to the boot partition (system-boot, mounted as /boot/firmware on the Pi) by flash_sdcard.ps1/.sh.
#
# Secrets: this file holds only the SHA-512 crypt HASH of the login password (never the plaintext).
# The Wi-Fi key lives in network-config as a derived 64-hex PSK. Treat both files as sensitive anyway:
# anyone who can read the SD card can try to brute-force the hash.
#
# The default 'ubuntu' user is NOT created (the users: list below has no 'default' entry).
# STATUS: UNVERIFIED ON REAL HARDWARE (rendered and parsed on a PC only).

hostname: {{HOSTNAME}}
preserve_hostname: false
manage_etc_hosts: true
timezone: {{TIMEZONE}}
locale: {{LOCALE}}

ssh_pwauth: {{SSH_PWAUTH}}
disable_root: true

users:
  - name: {{USERNAME}}
    gecos: facedoor operator
    groups: [adm, sudo, video, dialout, plugdev]
    shell: /bin/bash
    lock_passwd: false
    passwd: {{PASSWORD_HASH}}
{{SSH_KEYS_BLOCK}}

chpasswd:
  expire: false

# Package installation is done by the first-boot service (deploy/install_rpi.sh), not by cloud-init,
# so that a failure is logged in one place and can be retried on the next boot.
package_update: false
package_upgrade: false

write_files:
  - path: /etc/facedoor/firstboot.env
    owner: root:root
    permissions: "0644"
    content: |
{{ENV_CONTENT}}
  - path: /etc/systemd/system/facedoor-firstboot.service
    owner: root:root
    permissions: "0644"
    content: |
      # facedoor one-shot installer (generated by deploy/sdcard). Runs on every boot until it succeeds,
      # then writes /var/lib/facedoor/firstboot.done and disables itself. It never drives GPIO outputs.
      [Unit]
      Description=facedoor first-boot install (bundle verify, extract, install_rpi.sh)
      Wants=network-online.target
      After=network-online.target cloud-final.service
      ConditionPathExists=!/var/lib/facedoor/firstboot.done

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/facedoor-firstboot
      RemainAfterExit=yes
      TimeoutStartSec=3600
      StandardOutput=journal+console
      StandardError=journal+console

      [Install]
      WantedBy=multi-user.target

runcmd:
  - [install, -m, "0755", -o, root, -g, root, "/boot/firmware/{{FIRSTBOOT_NAME}}", /usr/local/sbin/facedoor-firstboot]
  - [systemctl, daemon-reload]
  - [systemctl, enable, facedoor-firstboot.service]
  # --no-block: the unit is ordered After=cloud-final.service, so it starts once cloud-init is finished.
  - [systemctl, start, --no-block, facedoor-firstboot.service]

final_message: "facedoor cloud-init done after $UPTIME s; install log: /var/log/facedoor-firstboot.log"
